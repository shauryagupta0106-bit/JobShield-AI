# ==============================================================================
# JobShield AI - Environment Configuration Template
# Copy this file to .env and configure your values.
# Do not commit real credentials to version control.
# ==============================================================================

# Required: PostgreSQL connection string
# Example: postgresql://postgres:password@localhost:5432/jobshield
# If using Supabase, use the URI from Project Settings -> Database -> Connection String (URI):
# Example: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Required: Secret key for signing anonymous session cookies (minimum 16 chars)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: TinyFish API key for live web search and career page retrieval
# Obtain at: https://tinyfish.ai
TINYFISH_API_KEY=

# Optional: Groq API key for fast, structured AI explanations and claim summaries
# Obtain at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: API server port (defaults to 5000)
PORT=5000

